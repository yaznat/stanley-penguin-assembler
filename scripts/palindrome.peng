            JMP start               ; entry point

; --- DATA ---
       one: 0x00000001              ; the value 1

word_front: 3                       ; pointer to 'r'
        r1: 0x00000052              ; 'r'
        a1: 0x00000041              ; 'a'
        c1: 0x00000043              ; 'c'
        e:  0x00000045              ; 'e'
        c2: 0x00000043              ; 'c'
        a2: 0x00000041              ; 'a'
        r2: 0x00000052              ; 'r'
 word_back: 9                       ; pointer to back 'r'

 not_front: 12                      ; pointer to 'n'
     not_1: 0x0000006E              ; 'n'
     not_2: 0x0000006F              ; 'o'
     not_3: 0x00000074              ; 't'
     not_4: 0x00000020              ; space
  not_back: 16                      ; pointer to back (exclusive)

 pal_front: 18                      ; pointer to 'p'
     pal_1: 0x00000070              ; 'p'
     pal_2: 0x00000061              ; 'a'
     pal_3: 0x0000006C              ; 'l'
     pal_4: 0x0000000A              ; '\n'
  pal_back: 22                      ; pointer to back (exclusive)

; --- CODE ---
     start: LOAD [word_front]       ; load char at address stored in word_front
            SUB [word_back]         ; subtract char at address stored in word_back
            JGZ not_pal             ; if A > 0, it's not a palindrome
            JLZ not_pal             ; if A < 0, it's not a palindrome

            LOAD word_front         ; load the pointer value itself
            ADD one                 ; increment value
            STORE word_front        ; update pointer

            LOAD word_back          ; load the pointer value itself
            SUB one                 ; decrement value
            STORE word_back         ; update pointer

            SUB word_front          ; compare new pointers (back - front)
            JZ is_pal               ; if 0, odd-length palindrome confirmed
            SUB one                 ; check for even-length (back - front == 1)
            JZ is_pal               ; if 0, even-length palindrome confirmed
            JMP start               ; repeat loop

    is_pal: LOAD [pal_front]        ; load 'p'
            WRITE 0x01              ; write to port 1
            LOAD pal_front          ; load pointer
            ADD one                 ; increment value
            STORE pal_front         ; save pointer
            SUB pal_back            ; compare to end of string
            JZ end                  ; jump to end if finished printing "pal\n"
            JMP is_pal              ; repeat loop

    not_pal: LOAD [not_front]       ; load 'n'
            WRITE 0x01              ; write to port 1
            LOAD not_front          ; load pointer
            ADD one                 ; increment value
            STORE not_front         ; save pointer
            SUB not_back            ; compare to end of string
            JZ is_pal               ; jump to print "pal\n" if finished printing "not"
            JMP not_pal             ; repeat loop

        end: JMP end                ; terminate program