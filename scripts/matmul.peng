; --- Matrix Multiplication in Stanley/Penguin ---
;
; Computes C = A * B for row-major matrices.
; Matrix dimensions and contents are configurable.

         JMP    start

; --- matrix dimensions ---
 rows_a: 3
 cols_a: 4
 rows_b: 4
 cols_b: 3

; --- matrix a ---
  ptr_a: a_0

    a_0:  2
    a_1: -1
    a_2:  3
    a_3:  4

    a_4:  0
    a_5:  5
    a_6: -2
    a_7:  1

    a_8: -3
    a_9:  2
   a_10:  6
   a_11: -1

; --- matrix b ---
  ptr_b: b_0

    b_0:  1
    b_1:  3
    b_2: -2

    b_3:  4
    b_4: -1
    b_5:  2

    b_6: -3
    b_7:  5
    b_8:  1

    b_9:  2
   b_10:  0
   b_11: -4

; --- product matrix c ---   
  ptr_c: border                              ; store product outside of the program
 c_size: 0                                   ; to calculate

; --- error message ---
  ptr_e: e_0
  end_e: e_12

    e_0: 0x69                                ; 'i'
    e_1: 0x6e                                ; 'n'
    e_2: 0x76                                ; 'v'
    e_3: 0x61                                ; 'a'
    e_4: 0x6c                                ; 'l'
    e_5: 0x69                                ; 'i'
    e_6: 0x64                                ; 'd'
    e_7: 0x20                                ; ' '
    e_8: 0x64                                ; 'd'
    e_9: 0x69                                ; 'i'
   e_10: 0x6d                                ; 'm'
   e_11: 0x73                                ; 's'
   e_12: 0x0A                                ; '\n'

; --- constants ---
    one: 1
   zero: 0

; --- iteration variables ---
      i: 0
      j: 0
      k: 0

; --- temporary variables ---
  ptr_0: 0
  ptr_1: 0
  ptr_2: 0
product: 0

; --- validate dimensions ---
  start: LOAD   cols_a
         SUB    rows_b
         JGZ    invalid
         JLZ    invalid

; --- calculate product size ---
         LOAD   rows_a
         MUL    cols_b
         STORE  c_size
  
         LOAD   ptr_c
         STORE  ptr_0

; --- initialize product to zero ---
 init_c: LOAD   ptr_c
         ADD    c_size
         SUB    ptr_0
         JZ     i_loop
         LOAD   zero
         STORE  [ptr_0]
         LOAD   ptr_0
         ADD    one
         STORE  ptr_0
         JMP    init_c

; --- perform matmul with nested loops ---
 i_loop: LOAD   i
         SUB    rows_a
         JZ     finish

         ; --- reset j ---
         LOAD   zero
         STORE  j
         JMP    j_loop

  i_inc: LOAD   i
         ADD    one
         STORE  i
         JMP    i_loop

 j_loop: LOAD   j
         SUB    cols_b
         JZ     i_inc

         ; --- reset k ---
         LOAD   zero
         STORE  k
         JMP    k_loop

  j_inc: LOAD   j
         ADD    one
         STORE  j
         JMP    j_loop

 k_loop: LOAD   k
         SUB    cols_a
         JZ     j_inc

         ; --- C[i * cols_b + j] ---
         LOAD   i
         MUL    cols_b
         ADD    j
         ADD    ptr_c
         STORE  ptr_0

         ; --- A[i * cols_a + k] ---
         LOAD   i
         MUL    cols_a
         ADD    k
         ADD    ptr_a
         STORE  ptr_1

         ; --- B[k * cols_b + j] ---
         LOAD   k
         MUL    cols_b
         ADD    j
         ADD    ptr_b
         STORE  ptr_2

         ; --- C += A * B ---
         LOAD   [ptr_1]
         MUL    [ptr_2]
         STORE  product

         LOAD   [ptr_0]
         ADD    product
         STORE  [ptr_0]
 
         JMP    k_inc

  k_inc: LOAD   k
         ADD    one
         STORE  k
         JMP    k_loop


; --- print error message ---
invalid: LOAD   [ptr_e]
         WRITE  0x01;
         LOAD   ptr_e
         SUB    end_e
         JZ     end
         LOAD   ptr_e
         ADD    one
         STORE  ptr_e
         JMP    invalid
        

; --- prepare ptr_c for print ---
 finish: LOAD   ptr_c
         STORE  ptr_0
         JMP    print

; --- print products in row-major order ---
  print: LOAD   ptr_c
         ADD    c_size
         SUB    ptr_0
         JZ     end
         LOAD   [ptr_0]
         WRITE  0x00
         LOAD   ptr_0
         ADD    one
         STORE  ptr_0
         JMP    print
 
    end: JMP    end

 border: 0                                   ; sentinel value used to know when the program ends